# Copy this file to .env and fill in your own values. Never commit .env.
#
# OpenAI API key. Optional — the app starts and both "Explore trends" and
# "Compare and rank" are fully usable with no key set at all (NFR-011). Only
# "Ask the data" requires it.
OPENAI_API_KEY=

# Optional. Overrides the tested default model (see agent/config.py — the
# default is sourced from SPIKE-001). The challenge restricts model choice to
# below "GPT-5.5" and non-"Pro" tiers (CON-002) — see README.md for details.
OPENAI_MODEL=

# Optional. Python logging level for the app (e.g. DEBUG, INFO, WARNING).
LOG_LEVEL=INFO

# Optional. Path to a JSON-lines structured observability log (design §12) —
# one line per tool call/OpenAI call/guardrail trigger, correlated by
# session/turn ID, never containing the API key. If unset, logs go to
# stderr instead of a file. Example: LOG_FILE=logs/app.jsonl
LOG_FILE=
